{
  "manifest_version": 3,
  "name": "Tools By DCX",
  "short_name": "Tools By DCX",
  "version": "2.4.8",
  "version_name": "v2.4.8",
  "description": "Tools By DCX \u2014 Google Flow Video & Nano Banana Image access manager.",
  "minimum_chrome_version": "119",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "alarms",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://flow.toolsbydcx.com/*",
    "https://*.flow.toolsbydcx.com/*",
    "*://*.google.com/*",
    "*://labs.google/*",
    "*://*.labs.google/*",
    "https://aisandbox-pa.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://labs.google/*",
        "*://*.labs.google/*"
      ],
      "js": [
        "flow-shield.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.labs.google/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://flow.toolsbydcx.com/*",
        "https://*.flow.toolsbydcx.com/*"
      ],
      "js": [
        "portal-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tools By DCX v2.4.8"
  }
}
