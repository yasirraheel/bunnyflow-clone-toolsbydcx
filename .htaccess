RewriteEngine On

# Existing frontend assets are kept at the document root so Apache can serve
# them directly without exposing the nested Laravel public path.
RewriteRule ^(?:assets|videos)(?:/|$) - [L]
RewriteRule ^(?:bunny-logo\.png|support-icon\.png|hero-characters\.png|favicon\.ico)$ - [L]

# All application routes, including /api/*, go through Laravel.
RewriteRule ^ laravel-app/public/index.php [L,QSA]
