RewriteEngine On

RewriteRule ^laravel-app/public/ - [L]

# Laravel is the only backend entrypoint. Frontend assets stay pixel-identical
# but are served from Laravel's public directory.
RewriteRule ^(?:assets|videos)(?:/|$) laravel-app/public/$0 [L]
RewriteRule ^(?:bunny-logo\.png|support-icon\.png|hero-characters\.png|favicon\.ico)$ laravel-app/public/$0 [L]
RewriteRule ^ laravel-app/public/index.php [L,QSA]
